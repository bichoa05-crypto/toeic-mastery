generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activation_codes {
  id                 String    @id @db.Uuid
  code               String    @unique
  plan_duration_days Int
  used_by_user_id    String?   @db.Uuid
  used_at            DateTime?
  created_at         DateTime  @default(now())
  profiles           profiles? @relation(fields: [used_by_user_id], references: [id])
}

model answer_reveal_logs {
  id          String    @id @db.Uuid
  user_id     String    @db.Uuid
  question_id String    @db.Uuid
  created_at  DateTime  @default(now())
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
  profiles    profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attempt_answers {
  id             String    @id @db.Uuid
  attempt_id     String    @db.Uuid
  question_id    String    @db.Uuid
  selected_label String?   @db.VarChar(1)
  is_correct     Boolean?
  is_flagged     Boolean   @default(false)
  time_spent_sec Int       @default(0)
  answered_at    DateTime?
  updated_at     DateTime
  attempts       attempts  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  questions      questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, question_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attempts {
  id                     String            @id @db.Uuid
  user_id                String            @db.Uuid
  test_id                String            @db.Uuid
  mode                   AttemptMode       @default(EXAM)
  status                 AttemptStatus     @default(IN_PROGRESS)
  current_question_index Int               @default(0)
  allowed_duration_sec   Int
  remaining_sec          Int
  listening_score        Int?
  reading_score          Int?
  total_score            Int?
  correct_count          Int?
  wrong_count            Int?
  skipped_count          Int?
  started_at             DateTime          @default(now())
  last_synced_at         DateTime          @default(now())
  submitted_at           DateTime?
  created_at             DateTime          @default(now())
  updated_at             DateTime
  attempt_answers        attempt_answers[]
  tests                  tests             @relation(fields: [test_id], references: [id], onDelete: Cascade)
  profiles               profiles          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  score_history          score_history[]
  study_sessions         study_sessions?

  @@index([test_id])
  @@index([user_id, status])
}

model bank_accounts {
  id             String   @id @db.Uuid
  user_id        String   @unique @db.Uuid
  bank_name      String
  account_number String
  account_holder String
  qr_image_url   String?
  created_at     DateTime @default(now())
  updated_at     DateTime
  profiles       profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([account_number])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookmarks {
  id                 String            @id @db.Uuid
  user_id            String            @db.Uuid
  type               BookmarkType
  question_id        String?           @db.Uuid
  vocabulary_word_id String?           @db.Uuid
  grammar_lesson_id  String?           @db.Uuid
  note               String?
  created_at         DateTime          @default(now())
  grammar_lessons    grammar_lessons?  @relation(fields: [grammar_lesson_id], references: [id], onDelete: Cascade)
  questions          questions?        @relation(fields: [question_id], references: [id], onDelete: Cascade)
  profiles           profiles          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vocabulary_words   vocabulary_words? @relation(fields: [vocabulary_word_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type, question_id, vocabulary_word_id, grammar_lesson_id])
}

model commissions {
  id                                         String           @id @db.Uuid
  referrer_id                                String           @db.Uuid
  referred_id                                String           @db.Uuid
  payment_id                                 String           @unique @db.Uuid
  amount                                     Int
  rate_percent                               Int
  tier                                       String?
  is_late_attribution                        Boolean          @default(false)
  status                                     CommissionStatus @default(PENDING)
  withdrawal_id                              String?          @db.Uuid
  fraud_note                                 String?
  confirm_at                                 DateTime
  confirmed_at                               DateTime?
  cancelled_at                               DateTime?
  created_at                                 DateTime         @default(now())
  payments                                   payments         @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  profiles_commissions_referred_idToprofiles profiles         @relation("commissions_referred_idToprofiles", fields: [referred_id], references: [id], onDelete: Cascade)
  profiles_commissions_referrer_idToprofiles profiles         @relation("commissions_referrer_idToprofiles", fields: [referrer_id], references: [id], onDelete: Cascade)
  withdrawals                                withdrawals?     @relation(fields: [withdrawal_id], references: [id])

  @@index([referrer_id, status])
  @@index([status, confirm_at])
}

model devices {
  id               String     @id @db.Uuid
  user_id          String     @db.Uuid
  type             DeviceType
  label            String
  fingerprint_hash String
  first_seen_at    DateTime   @default(now())
  last_seen_at     DateTime   @default(now())
  last_ip          String?
  deleted_at       DateTime?
  profiles         profiles   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, fingerprint_hash])
  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dictionary_entries {
  id             String   @id @db.Uuid
  word           String   @unique
  ipa            String?
  part_of_speech String?
  meaning_vi     String?
  definitions_en Json     @default("[]")
  synonyms       String[] @default([])
  antonyms       String[] @default([])
  examples       Json     @default("[]")
  word_family    Json     @default("[]")
  collocations   String[] @default([])
  audio_url_us   String?
  audio_url_uk   String?
  provider       String   @default("dictionaryapi")
  fetched_at     DateTime @default(now())
  updated_at     DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dictionary_history {
  id         String           @id @db.Uuid
  user_id    String           @db.Uuid
  word       String
  source     DictionarySource
  created_at DateTime         @default(now())
  profiles   profiles         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grammar_lessons {
  id             String         @id @db.Uuid
  topic_id       String         @db.Uuid
  slug           String         @unique
  title          String
  theory         String
  tips           String[]       @default([])
  examples       Json           @default("[]")
  created_at     DateTime       @default(now())
  updated_at     DateTime
  bookmarks      bookmarks[]
  grammar_topics grammar_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grammar_topics {
  id              String            @id @db.Uuid
  slug            String            @unique
  title           String
  category        String?
  summary         String?
  order_index     Int               @default(0)
  created_at      DateTime          @default(now())
  grammar_lessons grammar_lessons[]
  questions       questions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model passages {
  id          String        @id @db.Uuid
  test_id     String?       @db.Uuid
  part        TestPart
  format      PassageFormat @default(OTHER)
  layout      PassageLayout @default(SINGLE)
  title       String?
  texts       Json          @default("[]")
  audio_url   String?
  image_url   String?
  transcript  String?
  order_index Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime
  tests       tests?        @relation(fields: [test_id], references: [id], onDelete: Cascade)
  questions   questions[]

  @@index([test_id, part])
}

model payments {
  id                 String        @id @db.Uuid
  user_id            String        @db.Uuid
  order_id           String        @unique
  amount             Int
  plan_duration_days Int
  status             PaymentStatus @default(PENDING)
  vnp_transaction_no String?
  created_at         DateTime      @default(now())
  paid_at            DateTime?
  refunded_at        DateTime?
  commissions        commissions?
  profiles           profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                                            String                              @id @db.Uuid
  email                                         String                              @unique
  full_name                                     String?
  avatar_url                                    String?
  role                                          Role                                @default(STUDENT)
  current_score                                 Int?
  target_score                                  Int?
  exam_date                                     DateTime?                           @db.Date
  daily_study_target_minutes                    Int                                 @default(30)
  streak_count                                  Int                                 @default(0)
  longest_streak                                Int                                 @default(0)
  last_study_date                               DateTime?                           @db.Date
  created_at                                    DateTime                            @default(now())
  updated_at                                    DateTime
  plan                                          PlanTier                            @default(FREE)
  pro_expires_at                                DateTime?
  attribution_source                            AttributionSource?
  first_pro_payment_at                          DateTime?
  fraud_note                                    String?
  is_flagged_fraud                              Boolean                             @default(false)
  is_late_attribution                           Boolean                             @default(false)
  referral_code                                 String?                             @unique
  referred_at                                   DateTime?
  referred_by_profile_id                        String?                             @db.Uuid
  successful_referral_count                     Int                                 @default(0)
  google_id                                     String?                             @unique
  activation_codes                              activation_codes[]
  answer_reveal_logs                            answer_reveal_logs[]
  attempts                                      attempts[]
  bank_accounts                                 bank_accounts?
  bookmarks                                     bookmarks[]
  commissions_commissions_referred_idToprofiles commissions[]                       @relation("commissions_referred_idToprofiles")
  commissions_commissions_referrer_idToprofiles commissions[]                       @relation("commissions_referrer_idToprofiles")
  devices                                       devices[]
  dictionary_history                            dictionary_history[]
  payments                                      payments[]
  profiles                                      profiles?                           @relation("profilesToprofiles", fields: [referred_by_profile_id], references: [id])
  other_profiles                                profiles[]                          @relation("profilesToprofiles")
  push_subscriptions                            push_subscriptions[]
  question_reports                              question_reports[]
  referral_clicks                               referral_clicks[]
  saved_words                                   saved_words[]
  score_history                                 score_history[]
  study_sessions                                study_sessions[]
  tests                                         tests[]
  user_settings                                 user_settings?
  user_vocabulary                               user_vocabulary[]
  user_vocabulary_path_day_progress             user_vocabulary_path_day_progress[]
  withdrawals                                   withdrawals[]
}

model push_subscriptions {
  id           String    @id @db.Uuid
  user_id      String    @db.Uuid
  endpoint     String    @unique
  p256dh       String
  auth         String
  user_agent   String?
  created_at   DateTime  @default(now())
  last_sent_at DateTime?
  profiles     profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model question_options {
  id                     String    @id @db.Uuid
  question_id            String    @db.Uuid
  label                  String    @db.VarChar(1)
  content                String
  is_correct             Boolean   @default(false)
  distractor_explanation String?
  questions              questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, label])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model question_reports {
  id          String       @id @db.Uuid
  user_id     String       @db.Uuid
  question_id String       @db.Uuid
  reason      String
  message     String?
  status      ReportStatus @default(OPEN)
  created_at  DateTime     @default(now())
  resolved_at DateTime?
  questions   questions    @relation(fields: [question_id], references: [id], onDelete: Cascade)
  profiles    profiles     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id                 String               @id @db.Uuid
  test_id            String?              @db.Uuid
  test_section_id    String?              @db.Uuid
  passage_id         String?              @db.Uuid
  grammar_topic_id   String?              @db.Uuid
  part               TestPart
  order_index        Int                  @default(0)
  prompt             String
  image_url          String?
  audio_url          String?
  transcript         String?
  correct_label      String               @db.VarChar(1)
  explanation_vi     String
  grammar_topic_slug String?
  vocabulary_focus   String[]             @default([])
  evidence_text      String?
  difficulty         Difficulty           @default(MEDIUM)
  status             ContentStatus        @default(PUBLISHED)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  answer_reveal_logs answer_reveal_logs[]
  attempt_answers    attempt_answers[]
  bookmarks          bookmarks[]
  question_options   question_options[]
  question_reports   question_reports[]
  grammar_topics     grammar_topics?      @relation(fields: [grammar_topic_id], references: [id])
  passages           passages?            @relation(fields: [passage_id], references: [id])
  tests              tests?               @relation(fields: [test_id], references: [id], onDelete: Cascade)
  test_sections      test_sections?       @relation(fields: [test_section_id], references: [id])

  @@index([part])
  @@index([test_id, part, order_index])
}

model referral_clicks {
  id                  String   @id @db.Uuid
  referral_code       String
  referrer_profile_id String   @db.Uuid
  ip_address          String
  user_agent          String
  fingerprint_hash    String
  landing_path        String?
  clicked_at          DateTime @default(now())
  profiles            profiles @relation(fields: [referrer_profile_id], references: [id], onDelete: Cascade)

  @@index([fingerprint_hash, clicked_at])
  @@index([referrer_profile_id, clicked_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model saved_words {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  word        String
  note        String?
  is_favorite Boolean  @default(false)
  created_at  DateTime @default(now())
  meaning_vi  String?
  example_en  String?
  category    String?
  profiles    profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, word])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model score_conversion_tables {
  id              String   @id @db.Uuid
  name            String
  is_active       Boolean  @default(false)
  listening_table Json
  reading_table   Json
  created_at      DateTime @default(now())
  updated_at      DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model score_history {
  id              String    @id @db.Uuid
  user_id         String    @db.Uuid
  attempt_id      String?   @db.Uuid
  listening_score Int
  reading_score   Int
  total_score     Int
  recorded_at     DateTime  @default(now())
  attempts        attempts? @relation(fields: [attempt_id], references: [id])
  profiles        profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model study_sessions {
  id            String        @id @db.Uuid
  user_id       String        @db.Uuid
  activity_type StudyActivity
  duration_sec  Int           @default(0)
  started_at    DateTime      @default(now())
  ended_at      DateTime?
  metadata      Json?
  attempt_id    String?       @unique @db.Uuid
  attempts      attempts?     @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  profiles      profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, started_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model test_sections {
  id             String      @id @db.Uuid
  test_id        String      @db.Uuid
  part           TestPart
  title          String
  order_index    Int
  question_count Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime
  questions      questions[]
  tests          tests       @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@unique([test_id, part])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tests {
  id                  String          @id @db.Uuid
  slug                String          @unique
  title               String
  description         String?
  thumbnail_url       String?
  difficulty          Difficulty      @default(MEDIUM)
  status              ContentStatus   @default(DRAFT)
  is_full_test        Boolean         @default(true)
  duration_minutes    Int             @default(120)
  total_questions     Int             @default(200)
  listening_questions Int             @default(100)
  reading_questions   Int             @default(100)
  attempt_limit       Int?
  allow_replay        Boolean         @default(true)
  created_by          String?         @db.Uuid
  created_at          DateTime        @default(now())
  updated_at          DateTime
  attempts            attempts[]
  passages            passages[]
  questions           questions[]
  test_sections       test_sections[]
  profiles            profiles?       @relation(fields: [created_by], references: [id])

  @@index([is_full_test])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_settings {
  id                       String          @id @db.Uuid
  user_id                  String          @unique @db.Uuid
  theme                    ThemePreference @default(LIGHT)
  language                 String          @default("vi")
  audio_autoplay           Boolean         @default(true)
  default_playback_speed   Float           @default(1)
  dictionary_popup_enabled Boolean         @default(true)
  daily_reminder_enabled   Boolean         @default(false)
  daily_reminder_time      String?
  created_at               DateTime        @default(now())
  updated_at               DateTime
  site_theme               String          @default("aurora")
  profiles                 profiles        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_vocabulary {
  id                 String               @id @db.Uuid
  user_id            String               @db.Uuid
  vocabulary_word_id String               @db.Uuid
  repetitions        Int                  @default(0)
  interval_days      Int                  @default(0)
  ease_factor        Float                @default(2.5)
  next_review_date   DateTime             @default(now()) @db.Date
  last_reviewed_at   DateTime?
  is_learned         Boolean              @default(false)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  profiles           profiles             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vocabulary_words   vocabulary_words     @relation(fields: [vocabulary_word_id], references: [id], onDelete: Cascade)
  vocabulary_reviews vocabulary_reviews[]

  @@unique([user_id, vocabulary_word_id])
  @@index([user_id, next_review_date])
}

model user_vocabulary_path_day_progress {
  id                   String               @id @db.Uuid
  user_id              String               @db.Uuid
  day_id               String               @db.Uuid
  steps_completed      Int                  @default(0)
  stars                Int                  @default(0)
  completed_at         DateTime?
  created_at           DateTime             @default(now())
  updated_at           DateTime
  vocabulary_path_days vocabulary_path_days @relation(fields: [day_id], references: [id], onDelete: Cascade)
  profiles             profiles             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day_id])
}

model vocabulary_path_day_words {
  id                   String               @id @db.Uuid
  day_id               String               @db.Uuid
  vocabulary_word_id   String               @db.Uuid
  order_index          Int                  @default(0)
  vocabulary_path_days vocabulary_path_days @relation(fields: [day_id], references: [id], onDelete: Cascade)
  vocabulary_words     vocabulary_words     @relation(fields: [vocabulary_word_id], references: [id], onDelete: Cascade)

  @@unique([day_id, vocabulary_word_id])
}

model vocabulary_path_days {
  id                                String                              @id @db.Uuid
  path_id                           String                              @db.Uuid
  day_number                        Int
  tier_label                        String
  created_at                        DateTime                            @default(now())
  user_vocabulary_path_day_progress user_vocabulary_path_day_progress[]
  vocabulary_path_day_words         vocabulary_path_day_words[]
  vocabulary_paths                  vocabulary_paths                    @relation(fields: [path_id], references: [id], onDelete: Cascade)

  @@unique([path_id, day_number])
}

model vocabulary_paths {
  id                   String                 @id @db.Uuid
  slug                 String                 @unique
  title                String
  description          String?
  created_at           DateTime               @default(now())
  vocabulary_path_days vocabulary_path_days[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vocabulary_reviews {
  id                 String          @id @db.Uuid
  user_vocabulary_id String          @db.Uuid
  rating             ReviewRating
  previous_interval  Int
  new_interval       Int
  previous_ease      Float
  new_ease           Float
  reviewed_at        DateTime        @default(now())
  user_vocabulary    user_vocabulary @relation(fields: [user_vocabulary_id], references: [id], onDelete: Cascade)

  @@index([user_vocabulary_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vocabulary_topics {
  id               String             @id @db.Uuid
  slug             String             @unique
  name             String
  description      String?
  icon             String?
  order_index      Int                @default(0)
  created_at       DateTime           @default(now())
  category         String?
  vocabulary_words vocabulary_words[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vocabulary_words {
  id                        String                      @id @db.Uuid
  topic_id                  String                      @db.Uuid
  word                      String
  ipa                       String?
  part_of_speech            String?
  meaning_vi                String
  definition_en             String?
  example_en                String?
  example_vi                String?
  synonyms                  String[]                    @default([])
  antonyms                  String[]                    @default([])
  collocations              String[]                    @default([])
  audio_url_us              String?
  audio_url_uk              String?
  difficulty                Difficulty                  @default(MEDIUM)
  created_at                DateTime                    @default(now())
  updated_at                DateTime
  bookmarks                 bookmarks[]
  user_vocabulary           user_vocabulary[]
  vocabulary_path_day_words vocabulary_path_day_words[]
  vocabulary_topics         vocabulary_topics           @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([topic_id, word])
  @@index([topic_id])
}

model withdrawals {
  id             String           @id @db.Uuid
  user_id        String           @db.Uuid
  amount         Int
  status         WithdrawalStatus @default(PENDING)
  bank_name      String
  account_number String
  account_holder String
  admin_note     String?
  requested_at   DateTime         @default(now())
  processed_at   DateTime?
  commissions    commissions[]
  profiles       profiles         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([user_id])
}


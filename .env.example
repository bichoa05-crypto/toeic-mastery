# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for step-by-step setup instructions.

# --- Database (Supabase Postgres) ---------------------------------------
# DATABASE_URL: connection the app uses at runtime. In production, use
# Supabase's "Transaction pooler" (port 6543) so serverless functions don't
# exhaust Postgres connections.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct (non-pooled) connection used only by `prisma migrate`.
# In Supabase, this is the "Session pooler" or direct connection (port 5432).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Auth + Storage ---------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-public-key"
# Service role key — server-only, never expose to the client. Used for
# privileged admin operations. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Public site URL — used to build redirect links (e.g. password reset email).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Dictionary ------------------------------------------------------------
# "dictionaryapi" (default, free, no key) uses https://dictionaryapi.dev.
# Add your own provider in src/lib/services/dictionary-service.ts and set
# this to select it.
DICTIONARY_PROVIDER="dictionaryapi"

# --- Translation (English -> Vietnamese meanings) --------------------------
# "mymemory" (default, free, no key, rate-limited — fine for development).
# "google" or "deepl" for production; both require TRANSLATION_API_KEY.
TRANSLATION_PROVIDER="mymemory"
TRANSLATION_API_KEY=""

# --- VNPay (Pro upgrade checkout) -------------------------------------------
# From your VNPay merchant dashboard. Sandbox: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE="replace-with-merchant-tmn-code"
VNPAY_HASH_SECRET="replace-with-hash-secret"
# Sandbox for testing; swap to https://vnpayment.vn/paymentv2/vpcpay.html for production.
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
